{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../lib/contact/contactEmail.ts",
    "../lib/contact/contactSubmission.ts",
    "../lib/contact/sharedValidation.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
