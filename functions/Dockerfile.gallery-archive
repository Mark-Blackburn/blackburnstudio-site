# Build-only prototype: no Azure deployment or queue consumer configured.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY functions/package*.json ./functions/
RUN cd functions && npm ci
COPY functions/ ./functions/
COPY lib/contact/ ./lib/contact/
RUN cd functions && npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app/functions
COPY --from=build /app/functions/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/functions/dist ./dist
USER node
CMD ["node", "dist/functions/src/galleryArchiveContainerJob.js"]
