{
  "name": "blackburnstudio-contact-functions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "main": "dist/functions/src/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "func start"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "resend": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.36",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
